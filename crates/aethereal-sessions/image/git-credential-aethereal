#!/bin/sh
# git's credential helper in a session's container (ADR-0057), named by the image's system config: asked for credentials
# of the hub's repository, `$AETHEREAL_GIT_URL`, it answers `Basic` credentials whose password is the session's bearer,
# `$AETHEREAL_HUB_BEARER`, read from the environment as it is asked, so git never stores it. For any other place, and
# to store or erase, it answers nothing, so the bearer goes nowhere but the hub.
set -eu

[ "${1:-}" = get ] || exit 0

protocol=
host=
while IFS= read -r line && [ -n "$line" ]; do
    case $line in
        protocol=*) protocol=${line#protocol=} ;;
        host=*) host=${line#host=} ;;
    esac
done

[ -n "${AETHEREAL_GIT_URL:-}" ] || exit 0
[ -n "${AETHEREAL_HUB_BEARER:-}" ] || exit 0
case $AETHEREAL_GIT_URL in
    "$protocol://$host" | "$protocol://$host/"*) ;;
    *) exit 0 ;;
esac

printf 'username=session\npassword=%s\n' "$AETHEREAL_HUB_BEARER"
