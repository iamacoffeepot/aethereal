#!/bin/sh
# The command of every session's container (ADR-0057): it readies the session's work tree, then runs its arguments,
# Claude Code as the hub names it, in its place, so Claude Code keeps the container's stdin and stdout.
#
# The tree is `$HOME/work`, on the session's home volume, which outlives every container. It is cloned from the hub's
# repository, `$AETHEREAL_GIT_URL`, only when nothing is there: into `$HOME/work.cloning`, which takes the tree's place
# only once the clone is whole, so a clone cut short, as a container killed mid-clone leaves it, is never taken for the
# tree, and is removed before the next clone starts. When something is there, it must be a git repository, whose files
# are never touched: its `origin` is pointed at that URL, or put back at it when it was removed, and fetched, which
# moves only its remote-tracking refs, never a file of the tree. With no URL given, the hub serves no repository, and no
# tree is readied.
#
# Bootstrap is all or nothing: a step that fails, or runs past its limit of `$AETHEREAL_BOOTSTRAP_SECS` seconds, ends
# the container with the bootstrap's own code, 78 (sysexits' EX_CONFIG), saying why on stderr, which the hub keeps in the
# transcript. Claude Code never starts, nothing carries on half set up, and nothing is tried again here: the hub leaves
# the session hibernating, and its next wake runs the whole bootstrap again.
#
# The bearer, `$AETHEREAL_HUB_BEARER`, reaches git only through the image's credential helper, read from the
# environment as git asks, so it is never an argument or a file.
#
# The script prints nothing to its stdout, which is Claude Code's alone: while it bootstraps, its stdout is its stderr.
# Claude Code prints there as soon as it reads a line, so the hub tells a run that ended with 78 having printed nothing,
# a failed bootstrap, from Claude Code's own exit.
set -eu

# Ends the container with the bootstrap's code, saying why.
fail() {
    printf 'aethereal-session-start: %s\n' "$1" >&2
    exit 78
}

# Runs the step named `$1`, the rest of the arguments, within the limit: git never prompts, as no one can answer.
step() {
    what=$1
    shift
    status=0
    GIT_TERMINAL_PROMPT=0 timeout --kill-after=10 "$AETHEREAL_BOOTSTRAP_SECS" "$@" || status=$?
    case $status in
        0) ;;
        124 | 137) fail "$what ran past its limit of $AETHEREAL_BOOTSTRAP_SECS seconds" ;;
        *) fail "$what failed with exit code $status" ;;
    esac
}

[ -n "${AETHEREAL_GIT_URL:-}" ] || exec "$@"

# Until Claude Code runs, stdout is stderr; the container's stdout is kept on 3 for Claude Code.
exec 3>&1 1>&2

[ -n "${AETHEREAL_SESSION:-}" ] || fail "the container names no session in AETHEREAL_SESSION"
[ -n "${AETHEREAL_HUB_BEARER:-}" ] || fail "the container holds no bearer in AETHEREAL_HUB_BEARER"
case ${AETHEREAL_BOOTSTRAP_SECS:-} in
    "" | *[!0-9]*) fail "AETHEREAL_BOOTSTRAP_SECS is not a number of seconds" ;;
esac

# Every commit says which session made it, at an address that resolves nowhere.
step "git config of user.name" git config --global user.name "session $AETHEREAL_SESSION"
step "git config of user.email" git config --global user.email "session-$AETHEREAL_SESSION@aethereal.invalid"

# The credential helper the image's system config names answers for the hub's repository; what it answers is dropped.
step "the credential helper" git credential fill >/dev/null <<CREDENTIAL
url=$AETHEREAL_GIT_URL

CREDENTIAL

tree=$HOME/work
cloning=$HOME/work.cloning
url=$AETHEREAL_GIT_URL
if [ -e "$tree" ]; then
    git --git-dir="$tree/.git" rev-parse --git-dir >/dev/null || fail "$tree is there but is not a git repository"
    if git --git-dir="$tree/.git" remote get-url origin >/dev/null 2>&1; then
        step "pointing origin at $url" git --git-dir="$tree/.git" remote set-url origin "$url"
    else
        step "putting origin back at $url" git --git-dir="$tree/.git" remote add origin "$url"
    fi
    step "the fetch of origin" git --git-dir="$tree/.git" fetch --quiet origin
else
    step "the removal of $cloning, a clone cut short" rm -rf "$cloning"
    step "the clone of $url" git clone --quiet "$url" "$cloning"
    step "the move of the clone to $tree" mv "$cloning" "$tree"
fi

exec "$@" 1>&3 3>&-
